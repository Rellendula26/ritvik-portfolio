{
  "name": "ritvik-portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "dev:clean": "lsof -ti :3000 | xargs kill -9 2>/dev/null; rm -rf .next && next dev --hostname 127.0.0.1 --port 3000",
    "build": "next build",
    "start": "next start",
    "preview": "npm run build && npm start",
    "lint": "eslint",
    "compress:video": "bash scripts/compress-project-video.sh",
